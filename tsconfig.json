{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "lib": ["DOM", "ES2020"],
    "moduleResolution": "node",
    "types": ["chrome"],
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts",
    "options/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
