{
  "manifest_version": 3,
  "name": "Amazon Affiliate Code Generator for Cocoon",
  "version": "1.11",
  "description": "Generate affiliate link for Amazon products with keyword exclusion",
  "permissions": ["activeTab", "clipboardWrite", "storage", "notifications"],
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Generate Affiliate Link"
  },
  "icons": {
    "48": "icon.png"
  },
  "background": {
    "service_worker": "dist/src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.co.jp/*", "https://amazon.co.jp/*"],
      "js": ["dist/src/content.js"],
      "css": ["dist/assets/main-nZuTNy5X.css"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options/index.html",
  "commands": {
    "activate_extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Activate the extension"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
